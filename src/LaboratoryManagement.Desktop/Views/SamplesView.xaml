<UserControl x:Class="LaboratoryManagement.Desktop.Views.SamplesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Samples &amp; barcode tracking" Style="{StaticResource PageTitle}"/>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Scan or type a barcode, then press Enter" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Width="360" HorizontalAlignment="Left">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ScanCommand}"/></TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding ScanInfo}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
            </StackPanel>
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <DatePicker SelectedDate="{Binding From}" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding To}" Margin="0,0,8,0"/>
            <ComboBox Width="170" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Margin="0,0,8,0"/>
            <Button Content="Refresh list" Command="{Binding RefreshCommand}"/>
            <Button Content="Collect" Style="{StaticResource PrimaryButton}" Command="{Binding CollectCommand}" Visibility="{Binding RequireCollection, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Receive in lab" Style="{StaticResource PrimaryButton}" Command="{Binding ReceiveCommand}" Visibility="{Binding RequireReceive, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Reject..." Style="{StaticResource DangerButton}" Command="{Binding RejectCommand}"
                    Visibility="{Binding ShowFullWorkflowActions, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Request recollection" Command="{Binding RecollectCommand}"
                    Visibility="{Binding ShowFullWorkflowActions, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Print label" Command="{Binding LabelCommand}"/>
            <Button Content="Print all labels" Command="{Binding LabelAllCommand}"/>
            <Button Content="Order" Command="{Binding OrderCommand}"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Samples}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/>
                <DataGridTextColumn Header="Order" Binding="{Binding OrderNo}" Width="150"/>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="170"/>
                <DataGridTextColumn Header="Specimen" Binding="{Binding Specimen}" Width="100"/>
                <DataGridTextColumn Header="Container" Binding="{Binding Container}" Width="170"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                <DataGridCheckBoxColumn Header="Recollect" Binding="{Binding IsRecollection, Mode=OneWay}" Width="70"/>
                <DataGridTextColumn Header="Tests" Binding="{Binding Tests}" Width="*"/>
                <DataGridTextColumn Header="Rejection reason" Binding="{Binding RejectionReason}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
