<UserControl x:Class="LaboratoryManagement.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                <Border Grid.Column="1" Height="14" CornerRadius="3" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" Width="{Binding Width}" MinWidth="2"/>
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Hint}" FontSize="11" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="400" Margin="0,0,12,12"><StackPanel>
                    <TextBlock Text="Patient registrations (last 7 days)" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Registrations}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Width="400" Margin="0,0,12,12"><StackPanel>
                    <TextBlock Text="Monthly revenue (collections less refunds)" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Revenue}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Width="400" Margin="0,0,12,12"><StackPanel>
                    <TextBlock Text="Most frequently ordered tests" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding TopTests}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Width="400" Margin="0,0,12,12"><StackPanel>
                    <TextBlock Text="Test distribution by category" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel></Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
