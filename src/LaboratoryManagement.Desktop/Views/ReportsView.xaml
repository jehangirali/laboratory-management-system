<UserControl x:Class="LaboratoryManagement.Desktop.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Operational &amp; financial reports" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox Width="260" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding From}" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding To}" Margin="0,0,8,0"/>
            <Button Content="Run" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"/>
            <Button Content="Export CSV (Excel)" Command="{Binding ExportCommand}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="True"/>
    </DockPanel>
</UserControl>
