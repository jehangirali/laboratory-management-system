<UserControl x:Class="LaboratoryManagement.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
            <Button Content="Choose logo..." Command="{Binding BrowseLogoCommand}"/>
            <Button Content="Choose backup folder..." Command="{Binding BrowseBackupCommand}"/>
            <Button Content="Load demo data..." Command="{Binding DemoCommand}"/>
            <Button Content="Change my password" Command="{Binding PasswordCommand}"/>
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox Content="Use full workflow: sample collection, lab receipt and result verification"
                      IsChecked="{Binding FullWorkflowEnabled, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
            <TextBlock Text="Workflow changes apply after you sign out and sign in again." Style="{StaticResource Muted}" Margin="22,3,0,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Settings}" IsReadOnly="False" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Setting" Binding="{Binding Key}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
