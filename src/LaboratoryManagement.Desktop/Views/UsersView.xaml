<UserControl x:Class="LaboratoryManagement.Desktop.Views.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Users &amp; roles" Style="{StaticResource PageTitle}"/>
        <TabControl>
            <TabItem Header="Users">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="New user" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}"/>
                        <Button Content="Edit / reset password / deactivate" Command="{Binding EditCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
                        <DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"/></DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="180"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginAt, Converter={StaticResource LocalDate}}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Role permissions">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"/>
                    <DockPanel Grid.Column="2">
                        <Button DockPanel.Dock="Bottom" Content="Save permissions" Style="{StaticResource PrimaryButton}" Command="{Binding SavePermissionsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <DataGrid ItemsSource="{Binding Permissions}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Granted" Binding="{Binding IsGranted}" Width="70"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Permission" Binding="{Binding Code}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
