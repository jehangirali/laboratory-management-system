<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.PaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls"
        Title="{Binding Title}" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Caption}" FontWeight="SemiBold"/>
        <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Payment method" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" DisplayMemberPath="Name"/>
        <TextBlock Text="{Binding TextLabel}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</c:DialogWindowBase>
