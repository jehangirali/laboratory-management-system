<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.PatientHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls"
        Title="Patient history" Width="860" Height="520">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Patient.FullName}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Patient.PatientNo}" Style="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Open order" Command="{Binding OpenOrderCommand}"/>
            <Button Content="Print history" Command="{Binding PrintCommand}"/>
            <Button Content="Close" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding OrderedAt, Converter={StaticResource LocalDate}}" Width="150"/>
                <DataGridTextColumn Header="Order" Binding="{Binding OrderNo}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Report" Binding="{Binding Report.Status}" Width="130"/>
                <DataGridTextColumn Header="Net" Binding="{Binding NetAmount, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor.Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</c:DialogWindowBase>
