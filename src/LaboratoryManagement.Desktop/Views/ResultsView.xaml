<UserControl x:Class="LaboratoryManagement.Desktop.Views.ResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Result entry" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Order, patient or barcode">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RefreshCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="Include awaiting verification" IsChecked="{Binding IncludeReady}" Margin="0,0,10,0"
                                  Visibility="{Binding ShowFullWorkflowControls, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </StackPanel>
                <TabControl DockPanel.Dock="Top" Height="30" SelectedIndex="{Binding SelectedWorklistTab, Mode=TwoWay}">
                    <TabItem Header="Pending"/>
                    <TabItem Header="Completed"/>
                </TabControl>
                <DataGrid ItemsSource="{Binding ActiveWorklist}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding OrderedAt, Converter={StaticResource LocalDate}}" Width="150"/>
                        <DataGridTextColumn Header="Sample" Binding="{Binding SampleStatus}" Width="110"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Sheet, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Sheet.TestName}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Sheet.PatientName}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Sheet.PatientInfo, Mode=OneWay}"/><Run Text="  |  Order "/><Run Text="{Binding Sheet.OrderNo, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding Banner}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Save draft" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding CanEdit}"
                                Visibility="{Binding ShowFullWorkflowControls, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding SubmitLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanEdit}"
                                Visibility="{Binding ShowFullWorkflowControls, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveDirectCommand}" IsEnabled="{Binding CanEdit}"
                                Visibility="{Binding ShowSimplifiedSave, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Revision history" Command="{Binding HistoryCommand}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="False" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" IsReadOnly="True" Width="*"/>
                            <DataGridTemplateColumn Header="Result" Width="170">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox IsEditable="True" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Options}" BorderThickness="0"
                                              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Foreground="{Binding Flag, Converter={StaticResource FlagBrush}}" FontWeight="SemiBold"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Reference range" Binding="{Binding ReferenceText}" IsReadOnly="True" Width="240"/>
                            <DataGridTextColumn Header="Flag" Binding="{Binding FlagText}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
