<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.DoctorEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls"
        Title="{Binding Heading}" Width="440" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Specialization" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Specialization}"/>
        <TextBlock Text="Clinic / hospital" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Clinic}"/>
        <TextBlock Text="Contact" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Contact}"/>
        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Address}"/>
        <StackPanel Visibility="{Binding ShowCommission, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Commission rule" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding CommissionTypes}" SelectedItem="{Binding CommissionType}" Width="140"/>
                <TextBox Text="{Binding CommissionValue}" Width="90" Margin="8,0,0,0"/>
                <TextBlock Text="(% of net, or fixed amount per order)" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</c:DialogWindowBase>
