<Window x:Class="LaboratoryManagement.Desktop.Views.ErrorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common"
        Title="Setup problem" Width="640" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="22">
        <TextBlock Text="The database could not be initialized" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
        <TextBlock x:Name="Msg" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Text="Diagnostic details (credentials removed)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto"/>
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource Muted}"
                   Text="Check that the application can create files under %ProgramData%\LaboratoryManagement. The database key is protected for the current Windows user. Logs: %LocalAppData%\LaboratoryManagement\logs."/>
        <Button Content="Close" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click" IsDefault="True"/>
    </StackPanel>
</Window>
