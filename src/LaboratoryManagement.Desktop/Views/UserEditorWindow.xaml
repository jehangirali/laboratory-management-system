<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.UserEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls"
        Title="{Binding Heading}" Width="460" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Username *" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Username}"/>
        <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding FullName}"/>
        <TextBlock Text="Designation (printed under signature)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Designation}"/>
        <TextBlock Text="Signature text (shown on verified reports)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding SignatureText}"/>
        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding NewPassword}"/>
        <TextBlock Text="Roles" Style="{StaticResource FieldLabel}"/>
        <ItemsControl ItemsSource="{Binding Roles}">
            <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox Content="Account active" IsChecked="{Binding IsActive}" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</c:DialogWindowBase>
