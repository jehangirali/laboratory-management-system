<Window x:Class="LaboratoryManagement.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common"
        Title="Laboratory Management System" Width="1360" Height="840" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource PrimaryBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
                    <TextBlock Text="LAB" FontSize="26" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="{Binding LabName}" Foreground="#CCFBF1" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="14">
                    <TextBlock Text="{Binding User.FullName}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding User.Username}" Foreground="#CCFBF1" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Password" Command="{Binding ChangePasswordCommand}" Padding="8,3"/>
                        <Button Content="Sign out" Command="{Binding LogoutCommand}" Padding="8,3"/>
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavButton}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="14"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="22,18,22,14"/>
    </Grid>
</Window>
