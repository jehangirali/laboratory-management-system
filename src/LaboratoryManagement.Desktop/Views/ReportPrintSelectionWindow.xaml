<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.ReportPrintSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common"
        Title="{Binding Title}" Width="480" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Choose the tests or panels to include in this report." TextWrapping="Wrap"/>
            <TextBlock Text="Selected tests will be printed together and can share a page." Margin="0,4,0,10" Foreground="DimGray" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"/>
                <Button Content="Clear all" Command="{Binding ClearAllCommand}" Margin="0"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}"
                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Continue to preview" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</c:DialogWindowBase>
