<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.ChangePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls"
        Title="Change password" Width="380" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Password must be at least 8 characters with letters and digits." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock Text="Current password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Cur" PasswordChanged="Pw_Changed"/>
        <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="New" PasswordChanged="Pw_Changed"/>
        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Conf" PasswordChanged="Pw_Changed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Change" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</c:DialogWindowBase>
