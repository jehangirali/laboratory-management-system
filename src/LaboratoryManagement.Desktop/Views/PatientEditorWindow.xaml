<c:DialogWindowBase x:Class="LaboratoryManagement.Desktop.Views.PatientEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls"
        Title="{Binding Heading}" Width="560" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}"/>
                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Phone}"/>
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Father / husband name" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Father}"/>
                <TextBlock Text="Date of birth (or enter age in years below)" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Dob}"/>
                <TextBlock Text="Age (years)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding AgeYears}"/>
                <TextBlock Text="WhatsApp" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding WhatsApp}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="CNIC" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Cnic}"/>
        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Address}" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</c:DialogWindowBase>
