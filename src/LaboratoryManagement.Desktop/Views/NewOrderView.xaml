<UserControl x:Class="LaboratoryManagement.Desktop.Views.NewOrderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="New laboratory order" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Patient (type name, ID, phone or CNIC)" Style="{StaticResource FieldLabel}"/>
                                <ctl:SearchableLookup ItemsSource="{Binding PatientResults}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" SearchText="{Binding PatientSearch, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayText" AddNewLabel="+ Add new patient" AddNewCommand="{Binding AddPatientCommand}" Placeholder="Search patient..."/>
                                <TextBlock Text="{Binding PatientInfo}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Referring doctor (optional)" Style="{StaticResource FieldLabel}"/>
                                <ctl:SearchableLookup ItemsSource="{Binding DoctorResults}" SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}" SearchText="{Binding DoctorSearch, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayText" AddNewLabel="+ Add new doctor" AddNewCommand="{Binding AddDoctorCommand}" Placeholder="Search doctor..."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tests and panels" Style="{StaticResource SectionTitle}"/>
                            <TextBox Text="{Binding TestSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search tests by name or code"/>
                            <DataGrid ItemsSource="{Binding AvailableTests}" SelectedItem="{Binding SelectedAvailable}" Height="190" Margin="0,8,0,8">
                                <DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddTestCommand}"/></DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Panel" Binding="{Binding IsPanel, Mode=OneWay}" Width="50"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Add selected (or double-click)" Command="{Binding AddTestCommand}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Selected" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="60"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="80"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Flag}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Remove selected" Command="{Binding RemoveLineCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Billing" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal"/><TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=N2}" FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock Text="Discount (requires permission)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanDiscount}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Net amount" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Net, StringFormat=N2}" FontWeight="Bold" FontSize="16"/>
                    </Grid>
                    <TextBlock Text="Payment received now" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Pay full" Command="{Binding PayFullCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanReceivePayment}"/>
                        <TextBox Text="{Binding PaymentText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReceivePayment}"/>
                    </DockPanel>
                    <TextBlock Text="Method" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" DisplayMemberPath="Name"/>
                    <TextBlock Text="Reference (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PaymentReference}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Balance due"/><TextBlock Grid.Column="1" Text="{Binding Balance, StringFormat=N2}" FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Create order" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Padding="18,8"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
