<UserControl x:Class="LaboratoryManagement.Desktop.Views.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common" xmlns:ctl="clr-namespace:LaboratoryManagement.Desktop.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Audit trail &amp; login history" Style="{StaticResource PageTitle}"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Width="240" Text="{Binding Text}" Margin="0,0,8,0" ToolTip="Search action, record, user or details"/>
            <DatePicker SelectedDate="{Binding From}" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding To}" Margin="0,0,8,0"/>
            <Button Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" IsDefault="True"/>
        </WrapPanel>
        <TabControl>
            <TabItem Header="Audit events">
                <DataGrid ItemsSource="{Binding Logs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding At, Converter={StaticResource LocalDate}, ConverterParameter='dd-MMM-yyyy HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200"/>
                        <DataGridTextColumn Header="Record" Binding="{Binding EntityType}" Width="100"/>
                        <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="150"/>
                        <DataGridTextColumn Header="Details (before/after)" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Login history">
                <DataGrid ItemsSource="{Binding Logins}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding At, Converter={StaticResource LocalDate}, ConverterParameter='dd-MMM-yyyy HH:mm:ss'}" Width="160"/>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="140"/>
                        <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="110"/>
                        <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="160"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
