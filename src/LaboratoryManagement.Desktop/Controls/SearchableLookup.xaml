<UserControl x:Class="LaboratoryManagement.Desktop.Controls.SearchableLookup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box" TextChanged="Box_TextChanged" PreviewKeyDown="Box_PreviewKeyDown"
                 GotKeyboardFocus="Box_GotFocus" LostKeyboardFocus="Box_LostFocus"/>
        <TextBlock x:Name="Watermark" IsHitTestVisible="False" Margin="8,0,0,0" Foreground="#9AA5B1" VerticalAlignment="Center"/>
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#9AA5B1" BorderThickness="1" CornerRadius="4" MinWidth="280" Padding="2">
                <StackPanel>
                    <ListBox x:Name="List" MaxHeight="220" BorderThickness="0" PreviewMouseLeftButtonUp="List_MouseUp"/>
                    <TextBlock x:Name="Empty" Text="No matches" Margin="8,6" Foreground="#6B7785" Visibility="Collapsed"/>
                    <Button x:Name="AddBtn" Click="Add_Click" HorizontalContentAlignment="Left" Margin="2" Padding="8,6" Background="#E6F6F4"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
