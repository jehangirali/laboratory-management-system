<Application x:Class="LaboratoryManagement.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LaboratoryManagement.Desktop.Common"
             xmlns:vm="clr-namespace:LaboratoryManagement.Desktop.ViewModels"
             xmlns:v="clr-namespace:LaboratoryManagement.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <c:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <c:InverseBoolConverter x:Key="InvBool"/>
            <c:LocalDateConverter x:Key="LocalDate"/>
            <c:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <c:FlagBrushConverter x:Key="FlagBrush"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PatientsViewModel}"><v:PatientsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DoctorsViewModel}"><v:DoctorsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TestsViewModel}"><v:TestsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewOrderViewModel}"><v:NewOrderView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrdersViewModel}"><v:OrdersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SamplesViewModel}"><v:SamplesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><v:ResultsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VerificationViewModel}"><v:VerificationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}"><v:BackupView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
